# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/v1/telegram/webhook
TELEGRAM_CHAT_ID=your_personal_telegram_chat_id

# ── Database (MySQL) ───────────────────────────────────────────
# App connection settings (used by src/config/settings.py)
DB_HOST=localhost
DB_PORT=3306
DB_USER=jobforge
DB_PASSWORD=password
DB_NAME=jobforge_db
# Docker Compose variables (used only by docker-compose.yml)
# MYSQL_ROOT_PASSWORD is set directly in docker-compose.yml

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ── LLM APIs ──────────────────────────────────────────────────
# Primary key — required
GOOGLE_API_KEY=your_google_api_key
# Additional keys for round-robin rotation (optional, add as many as needed)
# GEMINI_API_KEY_2=your_second_key
# GEMINI_API_KEY_3=your_third_key

# ── Web Scraping ───────────────────────────────────────────────
FIRECRAWL_API_KEY=your_firecrawl_api_key

# ── Gmail OAuth2 ──────────────────────────────────────────────
GMAIL_CLIENT_ID=your_oauth_client_id
GMAIL_CLIENT_SECRET=your_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:8080/oauth/callback
GMAIL_TOKEN_PATH=./gmail_token.json

# ── App ────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=https://yourdomain.com
LOG_LEVEL=INFO
